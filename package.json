{
  "name": "bureau",
  "version": "0.1.0",
  "private": true,
  "description": "A desk for publishing schedules across Ghost and Buffer: drag-and-drop queues, cross-platform relationships, analytics, and an MCP server for AI analysis.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "mcp": "node --env-file-if-exists=.env dist/mcp/index.js",
    "mcp:dev": "tsx --env-file-if-exists=.env src/mcp/index.ts",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:commits": "commitlint --from origin/main --to HEAD --verbose"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.6",
    "lint-staged": "^17.6.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-auth": "^1.7.7",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
