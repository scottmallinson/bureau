{
  "name": "bureau",
  "version": "0.1.0",
  "private": true,
  "description": "A desk for publishing schedules across Ghost and Buffer: drag-and-drop queues, cross-platform relationships, analytics, and an MCP server for AI analysis.",
  "author": "Scott Mallinson <scott@scottmallinson.com>",
  "homepage": "https://github.com/scottmallinson/bureau",
  "type": "module",
  "main": "dist/desktop/main.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "mcp": "node --env-file-if-exists=.env dist/mcp/index.js",
    "mcp:dev": "tsx --env-file-if-exists=.env src/mcp/index.ts",
    "desktop": "npm run build:desktop && electron .",
    "build:desktop": "npm run build && tsc -p tsconfig.desktop.json",
    "dist:desktop": "npm run build:desktop && electron-builder --publish never",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.web.json && tsc -p tsconfig.desktop.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:commits": "commitlint --from origin/main --to HEAD --verbose"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "~45.0.0",
    "electron-builder": "^26.18.0",
    "husky": "^9.1.6",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-auth": "^1.7.12",
    "electron-updater": "^6.8.11",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
