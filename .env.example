# Copy to .env and fill in what you have. Leave a pair empty to use demo data
# for that integration; Ghost and Buffer are independent.

# Ghost: Settings > Integrations > Add custom integration
GHOST_ADMIN_API_URL=https://example.com
GHOST_ADMIN_API_KEY=

# Buffer: https://publish.buffer.com/settings/api
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
# BUFFER_API_URL=https://api.buffer.com

# Force demo data for both, even with credentials set.
# BUREAU_MOCK=1

# PORT=8787
# Bureau has no login, so it listens on loopback only unless you change this.
# HOST=127.0.0.1
# BUREAU_DATA_DIR=data
# BUREAU_HISTORY_DAYS=90
