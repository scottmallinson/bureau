# Copy to .env and fill in what you have. Leave a pair empty to use demo data
# for that integration, or to connect it in Bureau's Settings instead; Ghost
# and Buffer are independent, and what is set here takes precedence.

# Ghost: Settings > Integrations > Add custom integration
GHOST_ADMIN_API_URL=https://example.com
GHOST_ADMIN_API_KEY=

# Buffer: https://publish.buffer.com/settings/api
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
# BUFFER_API_URL=https://api.buffer.com

# Force demo data for both, even with credentials set.
# BUREAU_MOCK=1

# Sign-in. Required for HOST to be anything but loopback. Configure any of the
# providers below; each needs <BETTER_AUTH_URL>/api/auth/callback/<provider>
# registered as its redirect URL.
# BUREAU_ALLOWED_EMAILS=you@example.com
# Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# BUREAU_SESSION_DAYS=7

# PORT=8787
# Without a sign-in provider, Bureau refuses to listen beyond loopback.
# HOST=127.0.0.1
# BUREAU_DATA_DIR=data

# Redis (Upstash) instead of the data directory. Required on Vercel, where the
# Upstash integration sets these; locally, they point Bureau at the same data.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BUREAU_REDIS_PREFIX=bureau:
# BUREAU_HISTORY_DAYS=90
